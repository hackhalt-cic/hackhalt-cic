{
  "version": 2,
  "buildCommand": "echo 'Build complete'",
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/assets/:path*",
      "dest": "/public/assets/$1"
    },
    {
      "src": "/images/:path*",
      "dest": "/public/images/$1"
    },
    {
      "src": "/api/auth/login",
      "dest": "/api/auth/login.js"
    },
    {
      "src": "/api/auth(.*)",
      "dest": "/api/auth/index.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/[...].js"
    },
    {
      "src": "^/(admin-login|admin|blog-admin|add-blog|about|blogs|book-session|community|contact|events|hall-of-fame|legal-compliance|partners|404|index)$",
      "dest": "/public/$1.html"
    },
    {
      "src": "/(?!api)(.+)",
      "dest": "/public/$1"
    },
    {
      "src": "/",
      "dest": "/public/index.html"
    }
  ]
}