{
  "version": 2,
  "buildCommand": "npm install",
  "rewrites": [
    {
      "source": "/((?!api|assets|images|public).*)\\.html",
      "destination": "/server.js"
    },
    {
      "source": "/((?!api|assets|images|public).*)",
      "destination": "/server.js"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "https://hackhalt.org"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET,POST,PUT,DELETE,OPTIONS,PATCH"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type,Authorization"
        },
        {
          "key": "Access-Control-Allow-Credentials",
          "value": "true"
        }
      ]
    },
    {
      "source": "/(.*\\.html|/)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        }
      ]
    }
  ],
  "functions": {
    "api/auth/login.js": {
      "memory": 512,
      "maxDuration": 30
    },
    "server.js": {
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "public": true
}
