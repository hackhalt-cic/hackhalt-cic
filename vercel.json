{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "src": "/admin-login", "dest": "/public/admin-login.html" },
    { "src": "/admin", "dest": "/public/admin.html" },
    { "src": "/blog-admin", "dest": "/public/blog-admin.html" },
    { "src": "/add-blog", "dest": "/public/add-blog.html" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
