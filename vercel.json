{
  "version": 2,
  "buildCommand": "npm run build:vercel || true",
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "maxLambdaSize": "50mb",
        "nodeVersion": "24.x",
        "includeFiles": "**/**"
      }
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/public/assets/$1",
      "headers": {
        "cache-control": "public, max-age=3600, immutable"
      }
    },
    {
      "src": "/images/(.*)",
      "dest": "/public/images/$1",
      "headers": {
        "cache-control": "public, max-age=86400"
      }
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/(.*\\.html)$",
      "dest": "/public/$1"
    },
    {
      "src": "/(.*\\.json)$",
      "dest": "/public/$1"
    },
    {
      "src": "/(.*\\.xml)$",
      "dest": "/public/$1"
    },
    {
      "src": "/(.*)\\.(js|css|jpg|jpeg|png|gif|svg|ico|webp)$",
      "dest": "/public/$1.$2",
      "headers": {
        "cache-control": "public, max-age=3600"
      }
    },
    {
      "src": "^/admin.*",
      "dest": "/api/index.js"
    },
    {
      "src": "^/book-session.*",
      "dest": "/api/index.js"
    },
    {
      "src": "^/contact.*",
      "dest": "/api/index.js"
    },
    {
      "src": "^/blogs.*",
      "dest": "/api/index.js"
    },
    {
      "src": "^/.*",
      "dest": "/public/index.html"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
